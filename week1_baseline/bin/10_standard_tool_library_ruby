#!/usr/bin/env bash
set -euo pipefail

BASE="$(cd "$(dirname "$0")/.." && pwd)"   # week1_baseline

cd "$BASE/ruby/10_standard_tool_library"

# Unlike step 09, this step's gemspec depends on `mud_manager_mcp (~> 0.1)`, which
# is not published on rubygems.org — it's vendored at week1_baseline/mud_manager_mcp
# and built there as mud_manager_mcp-0.1.0.gem. Install it locally (idempotent) so
# `bundle install` can resolve the dependency without network access.
# Path is derived from $BASE rather than relative to the cd above, so it stays
# correct regardless of where the script is invoked from.
if ! gem list -i mud_manager_mcp -v 0.1.0 >/dev/null 2>&1; then
  gem install --local "$BASE/mud_manager_mcp/mud_manager_mcp-0.1.0.gem"
fi

bundle install --quiet
exec bundle exec ruby bin/boukensha
