#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../ruby/10_standard_tool_library"

# Unlike step 09, this step's gemspec depends on `mud_manager (~> 0.1)`, which
# is not published on rubygems.org — it's vendored at week0_explore/mud_manager
# and built there as mud_manager-0.1.0.gem. Install it locally (idempotent) so
# `bundle install` can resolve the dependency without network access.
if ! gem list -i mud_manager -v 0.1.0 >/dev/null 2>&1; then
  gem install --local ../../week0_explore/mud_manager/mud_manager-0.1.0.gem
fi

bundle install --quiet
exec bundle exec ruby bin/boukensha
